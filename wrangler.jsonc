{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lis",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // Persistent gift storage (Cloudflare KV). Letters survive redeploys
  // and are visible across all edge isolates.
  "kv_namespaces": [{ "binding": "GIFTS", "id": "a8794236aa0d49ba850cc385b1b0278c" }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}

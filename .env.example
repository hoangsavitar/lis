# URL được in vào toàn bộ QR chung của shop (web sự kiện chạy subdomain riêng,
# ví dụ https://2010.lisbylii.com/mo-qua). Biến NEXT_PUBLIC_* chốt lúc build,
# nên trên Cloudflare phải đặt trong Build variables.
NEXT_PUBLIC_COMMON_QR_URL=https://2010.lisbylii.com/open

# Lưu trữ lời nhắn production: Cloudflare KV binding GIFTS (khai báo trong
# wrangler.jsonc). Không cần DATABASE_URL cho web sự kiện này.
